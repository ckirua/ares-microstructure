# Research-tree conventions (root .gitignore also applies).
# Keep: NOTES / CANDIDATES / EXP_REPORT / EXPERIMENTS / DESK_MEMO /
# notebooks (not checkpoints) / scripts / lib / config.yaml templates.
# Ignore: out/ · logs/ · PDFs · _raw/ · checkpoints · caches · poller logs.

# Book PDFs + verbatim extracts
*.pdf
**/_raw/

# Experiment / live artifacts (keep .gitkeep placeholders)
# Use /** so the directory itself is not excluded (negations can apply).
**/out/**
!**/out/.gitkeep
!**/out/**/.gitkeep
**/logs/**
!**/logs/.gitkeep
paper_live.log
paper_live.log.*
v_fade_shadow.log
v_fade_shadow.log.*
*.log
*.pid

# Heavy caches outside out/ (edge_lab / v_shapes / filmonov / paper_throttle)
*.parquet
*.pkl
*.joblib
*.npy
*.npz
*.h5
*.feather
*.arrow

# Caches
**/__pycache__/
.ipynb_checkpoints/
.pytest_cache/
**/fig_cache/
