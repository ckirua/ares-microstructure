[Unit]
Description=ares v_shapes paper_live MinV/EGARCH SHADOW poller (HL ETH; no exchange orders)
Documentation=file:///home/dev/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/README.md
After=network-online.target
Wants=network-online.target

# DISTINCT from cross_miniflash ares-paper-live / ares-vfade-shadow.
# This unit = V-shapes MinV/EGARCH Promote monitors + Kill throttle paper state.
# Shadow only — never OE / mercat / gateway / live orders.
# exec.minv_breach_throttle stays Kill — telemetry + paper accounting only.

[Service]
Type=simple
WorkingDirectory=/home/dev/srv/ares-microstructure/research/books/v_shapes/applications/paper_live
EnvironmentFile=-%h/.env
Environment=PYTHONPATH=/home/dev/lab/lab-n2070/warehouse/src:/home/dev/srv/ares-startarb/src:/home/dev/srv/ares-microstructure:/home/dev/srv/ares-microstructure/research/books/v_shapes/scripts
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 run_paper_live.py --poll --interval 120 --quiet
Restart=on-failure
RestartSec=15
StandardOutput=append:/home/dev/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/logs/shadow.log
StandardError=append:/home/dev/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/logs/shadow.log
Nice=10

[Install]
WantedBy=default.target
