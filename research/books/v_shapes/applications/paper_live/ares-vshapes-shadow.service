[Unit]
Description=ares v_shapes paper_live MinV/EGARCH SHADOW poller (HL ETH; no exchange orders)
Documentation=file://%h/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/README.md
After=network-online.target
Wants=network-online.target

# DISTINCT from cross_miniflash ares-paper-live / ares-vfade-shadow.
# This unit = V-shapes MinV/EGARCH Promote monitors + Kill throttle paper state.
# Shadow only — never OE / mercat / gateway / live orders.
# exec.minv_breach_throttle stays Kill — telemetry + paper accounting only.

[Service]
Type=simple
WorkingDirectory=%h/srv/ares-microstructure/research/books/v_shapes/applications/paper_live
EnvironmentFile=-%h/.env
Environment=ARES_STARTARB=%h/srv/ares-startarb
Environment=WAREHOUSE_ROOT=%h/lab/lab-n2070/warehouse
Environment=WAREHOUSE_SRC=%h/lab/lab-n2070/warehouse/src
Environment=ARES_MICROSTRUCTURE=%h/srv/ares-microstructure
Environment=PYTHONPATH=%h/lab/lab-n2070/warehouse/src:%h/srv/ares-startarb/src:%h/srv/ares-microstructure:%h/srv/ares-microstructure/research/books/v_shapes/scripts
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 run_paper_live.py --poll --interval 120 --quiet
Restart=on-failure
RestartSec=15
StandardOutput=append:%h/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/logs/shadow.log
StandardError=append:%h/srv/ares-microstructure/research/books/v_shapes/applications/paper_live/logs/shadow.log
Nice=10

[Install]
WantedBy=default.target
